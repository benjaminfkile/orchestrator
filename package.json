{
  "name": "orchestrator",
  "version": "0.1.0",
  "description": "Event-driven lease orchestrator: watches external systems, matches events against user-configured rules, and runs data-driven playbooks inside wisper leases.",
  "main": "index.ts",
  "scripts": {
    "dev": "tsc-watch --onSuccess \"node dist/index.js\"",
    "build": "rimraf dist && tsc",
    "start": "npm run build && node dist/index.js",
    "test": "jest --runInBand --detectOpenHandles",
    "coverage": "jest --runInBand --detectOpenHandles --coverage",
    "seed:smoke-test": "npm run build && node dist/scripts/seed-smoke-test.js",
    "install:web": "npm --prefix web install",
    "build:web": "npm --prefix web run build",
    "dev:web": "npm --prefix web run dev",
    "test:web": "npm --prefix web test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@napi-rs/keyring": "^1.3.0",
    "better-sqlite3": "12.9.0",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "knex": "^2.5.1",
    "rimraf": "^6.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.14",
    "@types/jest": "^29.5.0",
    "@types/node": "^18.11.9",
    "@types/supertest": "^2.0.12",
    "jest": "^29.6.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.0",
    "tsc-watch": "^7.2.0",
    "typescript": "^4.9.5"
  }
}
