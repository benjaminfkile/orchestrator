# Copy to .env and fill in. All of this assumes a local, trusted setup:
# orchestrator, wisper-api, wisp, and wisp-agent all run on this machine.

# Port the orchestrator API binds to (loopback only).
PORT=3007

# Base directory for ALL of orchestrator's on-disk state: the SQLite DB file
# (default <ORCH_DATA_DIR>/orchestrator.sqlite), the per-dispatch log directory
# (<ORCH_DATA_DIR>/logs/dispatch-<id>.log), and the encrypted secret store
# (<ORCH_DATA_DIR>/secrets.enc + secrets.salt). Used verbatim (no "orchestrator"
# subdirectory is appended). Unset falls back to <OS user-data dir>/orchestrator
# (%APPDATA%\orchestrator on Windows, ~/Library/Application Support/orchestrator
# on macOS, $XDG_DATA_HOME or ~/.local/share, plus /orchestrator, elsewhere).
# Set this so a launcher can keep every piece of state in one folder.
# ORCH_DATA_DIR=

# SQLite database file path. Overrides ONLY the DB file (per-dispatch logs and
# the secret store still resolve against ORCH_DATA_DIR or the OS user-data
# default). Defaults to <ORCH_DATA_DIR or OS user-data dir>/orchestrator.sqlite.
# ORCH_DB_PATH=

# Base URL of the local wisper-api (in the default dev mode its dev endpoints
# must be enabled: Tunnel__EnableDevEndpoints=true).
# A plaintext http:// URL is only accepted for loopback hosts (localhost,
# 127.0.0.1, ::1). A non-loopback http:// endpoint is REFUSED at startup so the
# API key and injected secrets are never sent unencrypted — use https:// there.
WISPER_BASE_URL=http://localhost:8080

# Escape hatch: set to 1/true to downgrade the non-loopback plaintext-http
# refusal to a loud warning (for users terminating TLS themselves).
# WISPER_ALLOW_INSECURE_HTTP=

# Which wisper surface the client speaks to. "dev" (default) uses the
# unauthenticated /dev/leases harness. "v1" uses the authenticated /v1/leases
# consumer surface and sends Authorization: Bearer <key>, where the key is the
# WISPER_API_KEY *secret* (set it via the secrets store, NOT here). Any other
# value fails fast at boot.
# WISPER_MODE=dev

# The default host a playbook uses when it sets no `host`. In dev mode it is
# the hostId targeted on the /dev/leases endpoints (names the local host whose
# wisp-agent tunnel the leases run through). In v1 mode it is the default
# catalog host, matched by id OR name against GET /v1/catalog at dispatch time.
# Required to rent leases: leaving it unset does not crash boot but leaves the
# dispatcher idle.
WISPER_HOST_ID=

# Wisper client timeouts, in milliseconds. Both are optional; unset (or an
# invalid value) uses the default shown, so behavior is unchanged out of the box.
# Raise these when heavy images make lease provisioning or execs slow.
#
# Ceiling for the blocking create-lease call. The POST /dev/leases 201 is not
# sent until the lease is fully provisioned (clone/build/host can take minutes
# for heavy images), so this is the longest per-operation timeout.
# WISPER_CREATE_LEASE_TIMEOUT_MS=150000
#
# Per-call timeout for exec (pre steps, the streaming agent exec, and collect
# steps). For the streaming agent exec this is an inter-chunk IDLE window
# (never a wall-clock cap on total run time; the per-dispatch deadline bounds
# that). When UNSET the executor derives the value per call from the lease's
# REMAINING TTL plus a small margin, capped at about 6 hours; that lets a
# step or agent command run for the whole lease TTL instead of failing at a
# fixed 60 seconds. Set an explicit value here only when you want a fixed
# override across every exec. Precedence: this override wins over the
# executor's computed default. Release has its own separate short timeout
# (see WISPER_RELEASE_TIMEOUT_MS).
# WISPER_EXEC_TIMEOUT_MS=
#
# Per-call timeout for wisper lease-release requests: the executor's
# finally-block release, boot's orphan reconcile, the periodic release
# sweep, and the dispatcher's late release before a retryable requeue.
# Release is a quick control-plane DELETE and MUST NOT reuse the multi-hour
# exec-timeout cap: boot awaits the orphan reconcile sequentially before the
# dispatcher starts, and a hung socket per row would otherwise stall startup
# (or a whole sweep pass) for hours per row. Default 60 seconds.
# WISPER_RELEASE_TIMEOUT_MS=60000
#
# Public URL of the web UI. Clicking a desktop notification opens
# <ORCH_WEB_URL>/runs/<dispatch id> for run events, else /notifications.
# ORCH_WEB_URL=http://localhost:4400

# Secret store master key. When an OS keychain is available it holds a random
# key automatically and neither variable below is needed. When there is no
# keychain (headless/CI) or ORCH_DISABLE_KEYCHAIN=1 forces the fallback, the key
# is derived from ORCH_MASTER_KEY via scrypt against a persisted salt — set a
# strong passphrase and keep it stable, or the encrypted store won't decrypt.
# ORCH_DISABLE_KEYCHAIN=
# ORCH_MASTER_KEY=
