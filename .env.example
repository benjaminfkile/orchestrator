# Copy to .env and fill in. All of this assumes a local, trusted setup:
# orchestrator, wisper-api, wisp, and wisp-agent all run on this machine.

# Port the orchestrator API binds to (loopback only).
PORT=3007

# SQLite database path. Defaults to the OS user-data dir when unset.
# ORCH_DB_PATH=

# Base URL of the local wisper-api (dev endpoints must be enabled:
# Tunnel__EnableDevEndpoints=true).
# A plaintext http:// URL is only accepted for loopback hosts (localhost,
# 127.0.0.1, ::1). A non-loopback http:// endpoint is REFUSED at startup so the
# API key and injected secrets are never sent unencrypted — use https:// there.
WISPER_BASE_URL=http://localhost:8080

# Escape hatch: set to 1/true to downgrade the non-loopback plaintext-http
# refusal to a loud warning (for users terminating TLS themselves).
# WISPER_ALLOW_INSECURE_HTTP=

# Which wisper surface the client speaks to. "dev" (default) uses the
# unauthenticated /dev/leases harness. "v1" uses the authenticated /v1/leases
# consumer surface and sends Authorization: Bearer <key>, where the key is the
# WISPER_API_KEY *secret* (set it via the secrets store, NOT here). Any other
# value fails fast at boot.
# WISPER_MODE=dev

# The hostId to target on the wisper dev endpoints (names the local host
# whose wisp-agent tunnel the leases run through). In v1 mode this is also the
# interim host_id until catalog resolution lands.
WISPER_HOST_ID=

# Wisper client timeouts, in milliseconds. Both are optional; unset (or an
# invalid value) uses the default shown, so behavior is unchanged out of the box.
# Raise these when heavy images make lease provisioning or execs slow.
#
# Ceiling for the blocking create-lease call. The POST /dev/leases 201 is not
# sent until the lease is fully provisioned (clone/build/host can take minutes
# for heavy images), so this is the longest per-operation timeout.
# WISPER_CREATE_LEASE_TIMEOUT_MS=150000
#
# Timeout for exec and release calls. For the streaming agent exec it is an
# inter-chunk IDLE window (not a wall-clock cap on total run time — the
# per-dispatch deadline bounds that).
# WISPER_EXEC_TIMEOUT_MS=60000

# Secret store master key. When an OS keychain is available it holds a random
# key automatically and neither variable below is needed. When there is no
# keychain (headless/CI) or ORCH_DISABLE_KEYCHAIN=1 forces the fallback, the key
# is derived from ORCH_MASTER_KEY via scrypt against a persisted salt — set a
# strong passphrase and keep it stable, or the encrypted store won't decrypt.
# ORCH_DISABLE_KEYCHAIN=
# ORCH_MASTER_KEY=
